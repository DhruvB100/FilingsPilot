# FilingsPilot secrets - copy this to .env and fill it in
# Fill in the blanks. Leave a line empty if you don't have it yet.

# SEC EDGAR (they require a contact in the User-Agent)
EDGAR_USER_AGENT=FilingsPilot your-email@example.com

# which LLM to use: azure or gemini
LLM_PROVIDER=azure

# Azure OpenAI (from Azure AI Foundry -> your resource -> Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Google Cloud Agent Platform (Gemini) - only used for the model comparison
# put the service account json file inside the secrets/ folder
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-key.json
GEMINI_MODEL=gemini-2.5-flash

# Postgres (local docker by default, swap for Azure later)
DATABASE_URL=postgresql://filings:filings@localhost:5432/filings

# Azure Cosmos DB (chat history)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=filingspilot

# Jira
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=FP

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# guardrails
MAX_TOKENS_PER_REQUEST=4000
